# ===============================================================
# Raccoon Cafe - Plantilla de variables de entorno
# ---------------------------------------------------------------
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# ===============================================================

# Puerto en el que escucha el servidor Express.
# En Render la plataforma inyecta su propio PORT; este valor es el de desarrollo.
PORT=5000

# Cadena de conexion a MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@<cluster>/<base>?retryWrites=true&w=majority
MONGO_URI=

# Clave secreta usada para firmar los tokens JWT.
# Debe ser una cadena larga y aleatoria. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen del frontend autorizado para consumir la API (CORS).
# Desarrollo : http://localhost:5500
# Produccion : https://<usuario>.github.io
CLIENT_URL=http://localhost:5500
