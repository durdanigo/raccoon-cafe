# ============================================================
# Raccoon Cafe - Plantilla de variables de entorno (backend)
# ------------------------------------------------------------
# Copia este archivo como `.env` y completa los valores.
# `.env` esta en .gitignore: NUNCA se sube al repositorio.
# ============================================================

# --- Django ---
# Genera una clave propia, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Base de datos (opcional en local) ---
# Si DB_HOST no se define, se usa SQLite (db.sqlite3).
# En produccion (alwaysdata) define las cinco variables:
# DB_HOST=mysql-<cuenta>.alwaysdata.net
# DB_PORT=3306
# DB_NAME=<cuenta>_database
# DB_USER=<cuenta>
# DB_PASSWORD=<contrasena-de-mysql>
